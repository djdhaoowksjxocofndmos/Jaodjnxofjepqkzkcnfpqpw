function sendVehicleSyncPacket(car, x, y, z)
    if not car or not doesVehicleExist(car) then return end

    local vehicleId = sampGetVehicleIdByCarHandle(car)
    if not vehicleId or type(vehicleId) ~= "number" then return end

    local bs = raknetNewBitStream()
    if not bs then return end

    raknetBitStreamWriteInt16(bs, vehicleId)
    raknetBitStreamWriteInt16(bs, 0)
    raknetBitStreamWriteInt16(bs, 0)
    raknetBitStreamWriteInt16(bs, 0)

    raknetBitStreamWriteFloat(bs, x)
    raknetBitStreamWriteFloat(bs, y)
    raknetBitStreamWriteFloat(bs, z)

    local q1, q2, q3, q4 = getCarQuaternion(car)
    raknetBitStreamWriteFloat(bs, q1 or 0)
    raknetBitStreamWriteFloat(bs, q2 or 0)
    raknetBitStreamWriteFloat(bs, q3 or 0)
    raknetBitStreamWriteFloat(bs, q4 or 0)

    local vx, vy, vz = getVehicleVelocity(car)
    raknetBitStreamWriteFloat(bs, (vx or 0) * 0.3)
    raknetBitStreamWriteFloat(bs, (vy or 0) * 0.3)
    raknetBitStreamWriteFloat(bs, vz or 0)

    raknetBitStreamWriteFloat(bs, getVehicleHealth(car) or 1000.0)
    raknetBitStreamWriteInt8(bs, getCharHealth(PLAYER_PED) or 100)
    raknetBitStreamWriteInt8(bs, getCharArmour(PLAYER_PED) or 0)
    raknetBitStreamWriteInt8(bs, 0)

    raknetSendBitStream(bs, 201, 1, 1)
    raknetDeleteBitStream(bs)
end

function executeSionTP(x, y, z)
    if isTeleporting then return end

    lua_thread.create(function()
        isTeleporting = true
        isBypassing = true

        local ped = PLAYER_PED
        local groundZ = getGroundZFor3dCoord(x, y, 1000.0)
        if not groundZ or groundZ == 0 then
            groundZ = z or 10.0
        end
        groundZ = groundZ + 0.8

        if isCharInAnyCar(ped) then
            local car = getCarCharIsUsing(ped)
            if car and doesVehicleExist(car) then
                freezeCharPosition(ped, true)
                freezeCarPosition(car, true)
                wait(200)

                setCarCoordinates(car, x, y, groundZ)

                for i = 1, 8 do
                    sendVehicleSyncPacket(car, x, y, groundZ)
                    wait(50)
                end

                freezeCarPosition(car, false)
                freezeCharPosition(ped, false)
            end
        else
            freezeCharPosition(ped, true)
            wait(200)
            setCharCoordinates(ped, x, y, groundZ)
            setCharVelocity(ped, 0.0, 0.0, 0.0)
            wait(300)
            freezeCharPosition(ped, false)
        end

        wait(200)
        isBypassing = false
        isTeleporting = false
    end)
end

